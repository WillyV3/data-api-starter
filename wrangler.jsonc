{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-api-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  // public/ is the landing page + dashboard, served by the same Worker (no separate Pages project)
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "data-api-starter",
      // replace with the id printed by: pnpm wrangler d1 create data-api-starter
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
}
